import os
import subprocess
# Tận dụng lại các hàm và biến cấu hình từ builder_core đang có
from builder_core import write_log, run_cmd, DOCKER_USER, BASE_WORKSPACE

def redeploy_app(app_name: str, branch: str = "main"):
    write_log(app_name, f"\n=== [BẮT ĐẦU CI/CD REDEPLOY] {app_name} (Nhánh: {branch}) ===")
    WORKSPACE_DIR = f"{BASE_WORKSPACE}/{app_name}"
    
    # Tạo mã hash ngẫu nhiên (hoặc dùng timestamp) làm tag cho image mới để dễ Rollback
    import time
    commit_hash = str(int(time.time())) 
    NEW_IMAGE_TAG = f"{DOCKER_USER}/{app_name}:{commit_hash}"
    
    try:
        # 1. Cập nhật code mới nhất từ GitHub
        write_log(app_name, "[1] Đang kéo (Pull) mã nguồn mới nhất...")
        # Dùng fetch & reset để tránh lỗi xung đột (Merge Conflict) khi AI từng vá code nội bộ
        run_cmd(["git", "fetch", "--all"], app_name, cwd=WORKSPACE_DIR)
        run_cmd(["git", "reset", "--hard", f"origin/{branch}"], app_name, cwd=WORKSPACE_DIR)
        
        # Lưu ý: Các file untracked do AI tạo (nixpacks.toml, thư mục k8s/) 
        # sẽ không bị xóa bởi git reset, nên ta vẫn dùng lại được bình thường!

        # 2. Build Image mới (Bỏ qua khâu gọi AI)
        write_log(app_name, f"[2] Đang Build Docker Image phiên bản mới ({NEW_IMAGE_TAG})...")
        run_cmd(["nixpacks", "build", ".", "--name", NEW_IMAGE_TAG], app_name, cwd=WORKSPACE_DIR)
        
        # 3. Push Image lên Docker Hub
        write_log(app_name, "[3] Đang đẩy Image lên kho lưu trữ...")
        run_cmd(["docker", "push", NEW_IMAGE_TAG], app_name)
        
        # 4. Yêu cầu K3s cập nhật (Rolling Update - Cập nhật không gián đoạn)
        write_log(app_name, "[4] Đang Rollout bản cập nhật lên K3s...")
        run_cmd(["kubectl", "set", "image", f"deployment/{app_name}", f"{app_name}={NEW_IMAGE_TAG}"], app_name, cwd=WORKSPACE_DIR)
        
        write_log(app_name, f"=== [HOÀN TẤT CI/CD] {app_name} đã cập nhật lên phiên bản {commit_hash} ===")
        write_log(app_name, "DONE")
        
    except Exception as e:
        write_log(app_name, f"\n[LỖI CI/CD] {e}")
        write_log(app_name, "ERROR")
