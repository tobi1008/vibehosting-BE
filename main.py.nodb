from fastapi import FastAPI, BackgroundTasks, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import os
import json

# Import các hàm xử lý lõi
from builder_core import deploy_app, delete_app
from cicd_core import redeploy_app

# ==========================================
# KHỞI TẠO FASTAPI APP & CẤU HÌNH
# ==========================================
app = FastAPI(title="Vibe Hosting API", version="1.0.1")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# File JSON đóng vai trò như Database lưu cấu hình CI/CD của từng App
CONFIG_DB_FILE = "/opt/vibe-hosting/apps_config.json"

# ==========================================
# HÀM XỬ LÝ DATABASE MINI (Đọc/Ghi trạng thái CI/CD)
# ==========================================
def get_app_config(app_name: str) -> dict:
    if not os.path.exists(CONFIG_DB_FILE): 
        return {"auto_cicd": True} # Mặc định bật nếu chưa có file
    with open(CONFIG_DB_FILE, "r") as f:
        data = json.load(f)
    return data.get(app_name, {"auto_cicd": True})

def save_app_config(app_name: str, config: dict):
    data = {}
    if os.path.exists(CONFIG_DB_FILE):
        with open(CONFIG_DB_FILE, "r") as f: 
            data = json.load(f)
    data[app_name] = config
    with open(CONFIG_DB_FILE, "w") as f: 
        json.dump(data, f)

# ==========================================
# KHAI BÁO CẤU TRÚC DỮ LIỆU
# ==========================================
class DeployRequest(BaseModel):
    repo_url: str
    app_name: str
    app_domain: str

class AppConfigUpdate(BaseModel):
    auto_cicd: bool

# ==========================================
# 1. API DEPLOY LẦN ĐẦU & QUẢN LÝ APP
# ==========================================
@app.post("/api/deploy")
async def trigger_deploy(req: DeployRequest, background_tasks: BackgroundTasks):
    background_tasks.add_task(deploy_app, req.repo_url, req.app_name, req.app_domain)
    # Lưu cấu hình mặc định là Bật Auto CI/CD khi mới tạo app
    save_app_config(req.app_name, {"auto_cicd": True})
    return {"status": "success", "message": f"Hệ thống đang tiến hành Deploy {req.app_name}."}

@app.delete("/api/apps/{app_name}")
async def remove_app(app_name: str, background_tasks: BackgroundTasks):
    background_tasks.add_task(delete_app, app_name)
    return {"status": "success", "message": f"Hệ thống đang tiến hành xóa {app_name}."}

@app.get("/api/logs/{app_name}")
async def get_logs(app_name: str):
    log_path = f"/opt/vibe-hosting/logs/{app_name}.log"
    if not os.path.exists(log_path):
        raise HTTPException(status_code=404, detail="Chưa có dữ liệu log.")
    with open(log_path, "r", encoding="utf-8") as f:
        return {"status": "success", "logs": f.read()}

# ==========================================
# 2. CÁC API PHỤC VỤ TRANG QUẢN LÝ TẠI FRONTEND
# ==========================================

# A. Lấy trạng thái cấu hình hiện tại của App
@app.get("/api/apps/{app_name}/config")
async def read_config(app_name: str):
    config = get_app_config(app_name)
    return {"status": "success", "data": config}

# B. Bật/Tắt chế độ Auto CI/CD từ Frontend
@app.post("/api/apps/{app_name}/config")
async def update_config(app_name: str, req: AppConfigUpdate):
    save_app_config(app_name, {"auto_cicd": req.auto_cicd})
    return {"status": "success", "message": f"Đã {'bật' if req.auto_cicd else 'tắt'} Auto CI/CD cho {app_name}"}

# C. Nút Manual Deploy (Frontend gọi khi user bấm nút "Pull Code & Deploy")
@app.post("/api/apps/{app_name}/redeploy")
async def manual_redeploy(app_name: str, background_tasks: BackgroundTasks):
    background_tasks.add_task(redeploy_app, app_name, "main")
    return {"status": "success", "message": f"Đã ra lệnh kéo code và Deploy lại dự án {app_name}."}

# ==========================================
# 3. WEBHOOK TỰ ĐỘNG TỪ GITHUB
# ==========================================
@app.post("/api/webhooks/github/{app_name}")
async def github_webhook(app_name: str, request: Request, background_tasks: BackgroundTasks):
    try:
        payload = await request.json()
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid JSON payload")
    
    # 1. KIỂM TRA CÔNG TẮC AUTO CI/CD
    app_config = get_app_config(app_name)
    if not app_config.get("auto_cicd", True):
        return {"status": "ignored", "message": "Tính năng Auto CI/CD đang bị tắt bởi người dùng. Bỏ qua Webhook."}

    # 2. Nếu đang bật, tiến hành xử lý
    if "commits" in payload or "ref" in payload:
        branch = payload.get("ref", "refs/heads/main").split("/")[-1]
        background_tasks.add_task(redeploy_app, app_name, branch)
        return {"status": "success", "message": f"Auto CI/CD Pipeline đã kích hoạt cho [{app_name}]"}
        
    return {"status": "ignored", "message": "Không có commit code mới."}

# ==========================================
# KHỞI ĐỘNG SERVER (Chạy ở Port 8080)
# ==========================================
if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8080, reload=True)
